#!/usr/bin/env php
<?php
/**
 * Centinela - utilidad de administracion.
 *
 *   centinela-admin passwd        Fija la contrasena del panel
 *   centinela-admin totp          Genera o muestra el segundo factor
 *   centinela-admin email <dir>   Fija el administrador que recibe los avisos
 *   centinela-admin show          Muestra la configuracion vigente
 *   centinela-admin check         Diagnostico de la instalacion
 *   centinela-admin test-mail     Envia un correo de prueba
 */

declare(strict_types=1);

$base = dirname(__DIR__);
require $base . '/lib/util.php';
require $base . '/lib/config.php';
require $base . '/lib/platform.php';
require $base . '/lib/totp.php';
require $base . '/lib/guard.php';
require $base . '/lib/sysout.php';

$cmd = $argv[1] ?? 'help';
$cfg = load_config();
$cfgFile = $cfg['_file'] ?? '/etc/centinela/config.php';

function cwrite(string $s): void { fwrite(STDOUT, $s . "\n"); }
function cerr(string $s): void { fwrite(STDERR, $s . "\n"); }

/** Lee una linea del terminal, opcionalmente sin eco. */
function prompt(string $label, bool $hidden = false): string
{
    fwrite(STDOUT, $label);
    if ($hidden && stripos(PHP_OS, 'WIN') === false) {
        // stty solo esta disponible en un terminal real
        @shell_exec('stty -echo 2>/dev/null');
        $v = trim((string) fgets(STDIN));
        @shell_exec('stty echo 2>/dev/null');
        fwrite(STDOUT, "\n");
        return $v;
    }
    return trim((string) fgets(STDIN));
}

/** Vuelve a escribir el fichero de configuracion conservando el formato. */
function save_config(string $file, array $cfg): bool
{
    unset($cfg['_file']);
    $dir = dirname($file);
    if (!is_dir($dir) && !@mkdir($dir, 0750, true)) {
        cerr("No se pudo crear {$dir}");
        return false;
    }
    $body = "<?php\n"
        . "/**\n * Centinela - configuracion.\n * Generado por centinela-admin el " . date('d/m/Y H:i') . ".\n"
        . " * Contiene el hash de la contrasena y el secreto TOTP: mantener con permisos 0640.\n */\n\n"
        . 'return ' . var_export($cfg, true) . ";\n";

    $tmp = $file . '.tmp';
    if (@file_put_contents($tmp, $body, LOCK_EX) === false) {
        cerr("No se pudo escribir {$tmp}");
        return false;
    }
    @chmod($tmp, 0640);
    // El usuario web debe poder leerla; el grupo lo ajusta el instalador
    $st = @stat($file);
    if ($st !== false) {
        @chgrp($tmp, $st['gid']);
    }
    return @rename($tmp, $file);
}

switch ($cmd) {

case 'passwd':
    $user = $argv[2] ?? ($cfg['auth']['user'] ?: 'admin');
    if ($user === '--stdin') { $user = $cfg['auth']['user'] ?: 'admin'; }

    // Modo no interactivo: la contrasena llega por la entrada estandar.
    // Pensado para despliegues automatizados y para entornos sin terminal.
    if (in_array('--stdin', $argv, true)) {
        $p1 = trim((string) stream_get_contents(STDIN));
        if (strlen($p1) < 10) {
            cerr('La contrasena debe tener al menos 10 caracteres.');
            exit(1);
        }
        $cfg['auth']['user'] = $user;
        $cfg['auth']['hash'] = password_hash($p1, PASSWORD_BCRYPT, ['cost' => 12]);
        if (!save_config($cfgFile, $cfg)) { exit(1); }
        cwrite("Contrasena actualizada para «{$user}».");
        exit(0);
    }

    if (!stream_isatty(STDIN)) {
        cerr('Sin terminal interactivo. Usa: centinela-admin passwd --stdin <<< "la-contrasena"');
        exit(1);
    }
    $p1 = prompt("Contrasena para «{$user}»: ", true);
    if (strlen($p1) < 10) {
        cerr('La contrasena debe tener al menos 10 caracteres.');
        exit(1);
    }
    $p2 = prompt('Reptela: ', true);
    if ($p1 !== $p2) {
        cerr('No coinciden.');
        exit(1);
    }
    $cfg['auth']['user'] = $user;
    $cfg['auth']['hash'] = password_hash($p1, PASSWORD_BCRYPT, ['cost' => 12]);
    if (!save_config($cfgFile, $cfg)) { exit(1); }
    cwrite("Contrasena actualizada para «{$user}».");
    exit(0);

case 'totp':
    $regen = in_array('--new', $argv, true);
    $secret = (string) ($cfg['auth']['totp_secret'] ?? '');
    if ($secret === '' || $regen) {
        $secret = totp_secret();
        $cfg['auth']['totp_secret'] = $secret;
        $cfg['auth']['totp_required'] = true;
        if (!save_config($cfgFile, $cfg)) { exit(1); }
        cwrite($regen ? 'Secreto regenerado.' : 'Secreto generado.');
    }
    $account = ($cfg['auth']['user'] ?: 'admin') . '@' . php_uname('n');
    $uri = totp_uri($secret, $account);

    cwrite('');
    cwrite('  Segundo factor (TOTP)');
    cwrite('  ' . str_repeat('-', 52));
    cwrite('  Secreto : ' . chunk_split($secret, 4, ' '));
    cwrite('  Cuenta  : ' . $account);
    cwrite('');
    // Si qrencode esta disponible, dibujamos el codigo en el terminal
    $qr = run(['/usr/bin/which', 'qrencode'], 5);
    if ($qr['ok']) {
        cwrite(run(['/usr/bin/qrencode', '-t', 'ANSIUTF8', '-m', '2', $uri], 15)['out']);
    } else {
        cwrite('  (instala «qrencode» para ver el codigo QR aqui)');
        cwrite('  URI: ' . $uri);
    }
    cwrite('');
    cwrite('  Codigo actual: ' . totp_at($secret, intdiv(time(), 30)));
    cwrite('');
    exit(0);

case 'email':
    $addr = $argv[2] ?? '';
    if ($addr === '') {
        cerr('Uso: centinela-admin email admin@dominio.com[,otro@dominio.com]');
        exit(1);
    }
    $list = array_values(array_filter(array_map('trim', explode(',', $addr))));
    foreach ($list as $e) {
        if (!filter_var($e, FILTER_VALIDATE_EMAIL)) {
            cerr("Direccion invalida: {$e}");
            exit(1);
        }
    }
    $cfg['mail']['to'] = $list;
    $cfg['mail']['enabled'] = true;
    if (!save_config($cfgFile, $cfg)) { exit(1); }
    cwrite('Administrador de avisos: ' . implode(', ', $list));
    exit(0);

case 'user':
    // Cuentas adicionales del panel. La historica auth.user sigue viva; estas
    // van en auth.users, cada una con su contrasena y su secreto TOTP.
    $sub = $argv[2] ?? '--list';
    $cfg['auth']['users'] = (array) ($cfg['auth']['users'] ?? []);

    switch ($sub) {
        case '--list':
            cwrite('Cuentas del panel:');
            cwrite('  ' . ($cfg['auth']['user'] ?: '(sin definir)') . '  (principal)');
            foreach ($cfg['auth']['users'] as $u => $a) {
                cwrite('  ' . $u . '  (totp ' . (empty($a['totp_secret']) ? 'SIN CONFIGURAR' : 'configurado') . ')');
            }
            exit(0);

        case '--add':
            $u = trim((string) ($argv[3] ?? ''));
            if (!preg_match('/^[a-z][a-z0-9._-]{2,31}$/', $u)) {
                cerr('Uso: user --add nombre   (minusculas, 3-32 caracteres, sin espacios)');
                exit(1);
            }
            if ($u === ($cfg['auth']['user'] ?? '') || isset($cfg['auth']['users'][$u])) {
                cerr("La cuenta «{$u}» ya existe.");
                exit(1);
            }
            // Contrasena generada: legible por telefono, sin caracteres que se
            // confundan, y con entropia de sobra para bcrypt + TOTP delante.
            $alf = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';
            $trozos = [];
            for ($t = 0; $t < 4; $t++) {
                $x = '';
                for ($i = 0; $i < 5; $i++) {
                    $x .= $alf[random_int(0, strlen($alf) - 1)];
                }
                $trozos[] = $x;
            }
            $pass   = implode('-', $trozos);
            $secret = totp_secret();

            $cfg['auth']['users'][$u] = [
                'hash'          => password_hash($pass, PASSWORD_BCRYPT, ['cost' => 12]),
                'totp_secret'   => $secret,
                'totp_required' => true,
                'created'       => date('Y-m-d'),
            ];
            unset($cfg['_file']);
            if (!save_config($cfgFile, $cfg)) { exit(1); }

            $account = $u . '@' . php_uname('n');
            $uri = totp_uri($secret, $account);
            cwrite('');
            cwrite("  Cuenta «{$u}» creada.");
            cwrite('  ' . str_repeat('-', 52));
            cwrite('  Contrasena  : ' . $pass);
            cwrite('  TOTP secreto: ' . trim(chunk_split($secret, 4, ' ')));
            cwrite('  TOTP URI    : ' . $uri);
            $qr = run(['/usr/bin/which', 'qrencode'], 5);
            if ($qr['ok']) {
                cwrite(run(['/usr/bin/qrencode', '-t', 'ANSIUTF8', '-m', '2', $uri], 15)['out']);
            }
            cwrite('');
            cwrite('  La contrasena no vuelve a mostrarse: se guarda solo el hash.');
            exit(0);

        case '--passwd':
            $u = trim((string) ($argv[3] ?? ''));
            if (!isset($cfg['auth']['users'][$u])) { cerr("No existe la cuenta «{$u}»."); exit(1); }
            if (in_array('--stdin', $argv, true)) {
                $p1 = trim((string) stream_get_contents(STDIN));
            } else {
                if (!stream_isatty(STDIN)) { cerr('Sin terminal. Usa: user --passwd ' . $u . ' --stdin <<< "contrasena"'); exit(1); }
                $p1 = prompt("Contrasena para «{$u}»: ", true);
            }
            if (strlen($p1) < 10) { cerr('Minimo 10 caracteres.'); exit(1); }
            $cfg['auth']['users'][$u]['hash'] = password_hash($p1, PASSWORD_BCRYPT, ['cost' => 12]);
            unset($cfg['_file']);
            if (!save_config($cfgFile, $cfg)) { exit(1); }
            cwrite("Contrasena actualizada para «{$u}».");
            exit(0);

        case '--totp':
            $u = trim((string) ($argv[3] ?? ''));
            if (!isset($cfg['auth']['users'][$u])) { cerr("No existe la cuenta «{$u}»."); exit(1); }
            if (in_array('--new', $argv, true) || empty($cfg['auth']['users'][$u]['totp_secret'])) {
                $cfg['auth']['users'][$u]['totp_secret'] = totp_secret();
                unset($cfg['_file']);
                if (!save_config($cfgFile, $cfg)) { exit(1); }
                cwrite('Secreto TOTP ' . (in_array('--new', $argv, true) ? 'regenerado' : 'generado') . '.');
            }
            $sec = $cfg['auth']['users'][$u]['totp_secret'];
            cwrite('Secreto: ' . trim(chunk_split($sec, 4, ' ')));
            cwrite('URI    : ' . totp_uri($sec, $u . '@' . php_uname('n')));
            exit(0);

        case '--remove':
            $u = trim((string) ($argv[3] ?? ''));
            if (!isset($cfg['auth']['users'][$u])) { cerr("No existe la cuenta «{$u}»."); exit(1); }
            unset($cfg['auth']['users'][$u], $cfg['_file']);
            if (!save_config($cfgFile, $cfg)) { exit(1); }
            cwrite("Cuenta «{$u}» eliminada. Sus sesiones caducan solas al expirar.");
            exit(0);

        default:
            cwrite('Uso: centinela-admin user [--list|--add NOMBRE|--passwd NOMBRE [--stdin]|--totp NOMBRE [--new]|--remove NOMBRE]');
            exit(1);
    }

case 'guard':
    // Gestion de la geo-valla. La politica es un JSON aparte de config.php:
    // la escribe solo root, y este es el unico editor previsto.
    $gf  = guard_policy_file();
    $pol = guard_policy();
    $sub = $argv[2] ?? '--show';

    $guardar = function (array $pol) use ($gf): void {
        $json = json_encode($pol, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
        if (@file_put_contents($gf, $json . "\n", LOCK_EX) === false) {
            cerr("No se pudo escribir {$gf}");
            exit(1);
        }
        @chmod($gf, 0640);
        @chgrp($gf, 'centinela');
        cwrite("Politica guardada en {$gf}");
    };

    // Simula la politica contra el historico: que habria pasado.
    $simular = function (array $pol) {
        state_dir('/var/lib/centinela');
        $f = state_dir() . '/events.json';
        $store = is_file($f) ? (json_decode((string) file_get_contents($f), true) ?: []) : [];
        $asn = $store['asn'] ?? [];

        $den = $alw = $unk = 0;
        $denIntentos = 0;
        foreach ($store['ip_svc'] ?? [] as $ip => $svcs) {
            $toca = false;
            foreach ($pol['services'] as $svc) {
                if (!empty($svcs[$svc])) { $toca = true; break; }
            }
            if (!$toca) { continue; }
            $v = guard_verdict((string) $ip, $pol, $asn);
            if ($v === 'denied')      { $den++; $denIntentos += array_sum($svcs); }
            elseif ($v === 'allowed') { $alw++; }
            else                      { $unk++; }
        }

        cwrite('Simulacion contra el historico (' . count($store['ip_svc'] ?? []) . ' IPs con actividad):');
        cwrite(sprintf('  Fuera de politica : %d IPs (%s intentos) -> se banearian', $den, number_format($denIntentos, 0, ',', '.')));
        cwrite("  Dentro            : {$alw} IPs");
        cwrite("  Sin pais resuelto : {$unk} IPs (la valla espera a resolverlas)");

        // Lo que de verdad importa: ¿algun acceso TUYO caeria fuera?
        $malos = [];
        foreach ($store['successes'] ?? [] as $sx) {
            if (!in_array($sx['service'] ?? '', $pol['services'], true)) { continue; }
            if (guard_verdict((string) $sx['ip'], $pol, $asn) === 'denied') {
                $malos[$sx['ip']] = ($malos[$sx['ip']] ?? 0) + 1;
            }
        }
        if ($malos) {
            cwrite('');
            cwrite('  ATENCION: accesos correctos que quedarian FUERA de la politica:');
            foreach ($malos as $ip => $n) {
                $cc = $asn[$ip]['cc'] ?? '?';
                cwrite("    {$ip} ({$cc}): {$n} acceso(s). La valla no los banearia, pero avisaria cada vez.");
            }
        } else {
            cwrite('  Todos los accesos correctos del historico quedan dentro. ');
        }
        return $malos;
    };

    switch ($sub) {
        case '--show':
            cwrite('Fichero  : ' . $gf . (is_file($gf) ? '' : ' (no existe: valla desactivada)'));
            cwrite('Estado   : ' . ($pol['enabled'] ? ($pol['action'] === 'observe' ? 'OBSERVACION (no banea)' : 'ACTIVA') : 'desactivada'));
            cwrite('Servicios: ' . implode(', ', $pol['services']));
            cwrite('Paises   : ' . ($pol['allow_countries'] ? implode(', ', $pol['allow_countries']) : '(ninguno)'));
            cwrite('Rangos   : ' . ($pol['allow_ips'] ? implode(', ', $pol['allow_ips']) : '(ninguno)'));
            cwrite('Jail     : ' . $pol['jail']);
            exit(0);

        case '--simulate':
            $simular($pol);
            exit(0);

        case '--allow-country':
            $cc = strtoupper(trim((string) ($argv[3] ?? '')));
            if (!preg_match('/^[A-Z]{2}$/', $cc)) { cerr('Uso: guard --allow-country ES'); exit(1); }
            if (!in_array($cc, $pol['allow_countries'], true)) { $pol['allow_countries'][] = $cc; }
            $guardar($pol);
            exit(0);

        case '--deny-country':
            $cc = strtoupper(trim((string) ($argv[3] ?? '')));
            $pol['allow_countries'] = array_values(array_diff($pol['allow_countries'], [$cc]));
            $guardar($pol);
            exit(0);

        case '--allow-ip':
            $rango = trim((string) ($argv[3] ?? ''));
            $ipSola = explode('/', $rango)[0];
            if (!filter_var($ipSola, FILTER_VALIDATE_IP)) { cerr('Uso: guard --allow-ip 1.2.3.0/24'); exit(1); }
            if (!in_array($rango, $pol['allow_ips'], true)) { $pol['allow_ips'][] = $rango; }
            $guardar($pol);
            exit(0);

        case '--deny-ip':
            $rango = trim((string) ($argv[3] ?? ''));
            $pol['allow_ips'] = array_values(array_diff($pol['allow_ips'], [$rango]));
            $guardar($pol);
            exit(0);

        case '--observe':
            $pol['enabled'] = true;
            $pol['action']  = 'observe';
            $guardar($pol);
            cwrite('Valla en observacion: cuenta lo que banearia pero no banea.');
            exit(0);

        case '--enforce':
            // Cinturon antes de armarla: si algun acceso correcto del
            // historico cae fuera, exigimos verlo y confirmar con --force.
            $malos = $simular($pol);
            if ($malos && !in_array('--force', $argv, true)) {
                cwrite('');
                cerr('No se activa: hay accesos correctos fuera de la politica (arriba).');
                cerr('Anadelos con --allow-ip / --allow-country, o repite con --force.');
                exit(1);
            }
            if (!$pol['allow_countries'] && !$pol['allow_ips']) {
                cerr('No se activa: la politica esta vacia y banearia a todo el mundo.');
                exit(1);
            }
            $pol['enabled'] = true;
            $pol['action']  = 'ban';
            $guardar($pol);
            cwrite('Valla ACTIVA: baneara al primer intento fallido fuera de politica.');
            exit(0);

        case '--disable':
            $pol['enabled'] = false;
            $guardar($pol);
            cwrite('Valla desactivada. Los baneos ya hechos siguen en fail2ban.');
            exit(0);

        default:
            cwrite('Uso: centinela-admin guard [--show|--simulate|--allow-country CC|--deny-country CC');
            cwrite('       |--allow-ip CIDR|--deny-ip CIDR|--observe|--enforce [--force]|--disable]');
            exit(1);
    }

case 'update':
    $sub = $argv[2] ?? '--show';
    $cfg['update'] = (array) ($cfg['update'] ?? []);
    switch ($sub) {
        case '--show':
            $u = $cfg['update'];
            cwrite('Repositorio: ' . ($u['repo'] ?? '(sin configurar)'));
            cwrite('Modo       : ' . ($u['mode'] ?? 'notify')
                . '  (auto=aplica todo · patch=solo 1.0.x · notify=solo avisa)');
            cwrite('Prereleases: ' . (!empty($u['prereleases']) ? 'si' : 'no'));
            cwrite('Version instalada: ' . CENT_VERSION);
            $af = ($cfg['state_dir'] ?? '/var/lib/centinela') . '/update_available.json';
            if (is_file($af)) {
                $a = json_decode((string) file_get_contents($af), true) ?: [];
                cwrite('Disponible : ' . ($a['latest'] ?? '?') . ' (' . ($a['url'] ?? '') . ')');
            }
            exit(0);

        case '--repo':
            $repo = trim((string) ($argv[3] ?? ''));
            if (!preg_match('#^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$#', $repo)) {
                cerr('Uso: update --repo usuario/centinela'); exit(1);
            }
            $cfg['update']['repo'] = $repo;
            if (empty($cfg['update']['mode'])) { $cfg['update']['mode'] = 'notify'; }
            unset($cfg['_file']);
            if (!save_config($cfgFile, $cfg)) { exit(1); }
            cwrite("Repositorio de actualizacion: {$repo}");
            cwrite('Comprueba con: centinela-update --check');
            exit(0);

        case '--mode':
            $m = strtolower((string) ($argv[3] ?? ''));
            if (!in_array($m, ['auto', 'patch', 'notify'], true)) {
                cerr('Uso: update --mode auto|patch|notify'); exit(1);
            }
            $cfg['update']['mode'] = $m;
            unset($cfg['_file']);
            if (!save_config($cfgFile, $cfg)) { exit(1); }
            cwrite("Modo de actualizacion: {$m}");
            exit(0);

        case '--now':
            // Lanza el actualizador de inmediato (respeta la politica salvo --force)
            $forzar = in_array('--force', $argv, true) ? ' --force' : '';
            passthru('/usr/local/bin/centinela-update' . $forzar);
            exit(0);

        default:
            cwrite('Uso: centinela-admin update [--show|--repo usuario/nombre|--mode auto|patch|notify|--now [--force]]');
            exit(1);
    }

case 'syslog':
    $sub = $argv[2] ?? '--show';
    switch ($sub) {
        case '--show':
            $sc = sysout_cfg();
            cwrite('Estado    : ' . ($sc['enabled'] ? 'activado' : 'desactivado'));
            cwrite('Servidor  : ' . ($sc['server'] ?: '(sin configurar)'));
            cwrite('Protocolo : ' . $sc['proto']);
            cwrite('Facility  : ' . $sc['facility'] . ' (local' . ($sc['facility'] - 16) . ')');
            cwrite('Min. sev. : ' . $sc['min_sev']);
            cwrite('Eventos   : ' . implode(', ', $sc['events']));
            exit(0);

        case '--server':
            $srv = trim((string) ($argv[3] ?? ''));
            if ($srv === '') { cerr('Uso: syslog --server host[:puerto] [tcp|udp]'); exit(1); }
            $cfg['syslog'] = ($cfg['syslog'] ?? []) + [];
            $cfg['syslog']['server'] = $srv;
            $proto = strtolower((string) ($argv[4] ?? ''));
            if (in_array($proto, ['tcp', 'udp'], true)) { $cfg['syslog']['proto'] = $proto; }
            $cfg['syslog']['enabled'] = true;
            unset($cfg['_file']);
            if (!save_config($cfgFile, $cfg)) { cerr('No se pudo guardar la configuracion'); exit(1); }
            cwrite("Exportacion activada hacia {$srv}. Prueba con: centinela-admin syslog --test");
            exit(0);

        case '--min-sev':
            $sev = strtolower(trim((string) ($argv[3] ?? '')));
            if (!in_array($sev, ['info', 'warn', 'crit'], true)) { cerr('Uso: syslog --min-sev info|warn|crit'); exit(1); }
            $cfg['syslog']['min_sev'] = $sev;
            unset($cfg['_file']);
            if (!save_config($cfgFile, $cfg)) { cerr('No se pudo guardar'); exit(1); }
            cwrite("Umbral de incidencias: {$sev}");
            exit(0);

        case '--disable':
            $cfg['syslog']['enabled'] = false;
            unset($cfg['_file']);
            if (!save_config($cfgFile, $cfg)) { cerr('No se pudo guardar'); exit(1); }
            cwrite('Exportacion desactivada.');
            exit(0);

        case '--test':
            $r = sysout_send([[ 'sev' => 'info', 'body' => sysout_kv([
                'event' => 'test', 'msg' => 'mensaje de prueba de centinela',
            ])]]);
            if ($r['error'] !== '') { cerr('Fallo: ' . $r['error']); exit(1); }
            cwrite('Enviado ' . $r['sent'] . ' mensaje(s). Comprueba en el servidor remoto que ha llegado.');
            cwrite('Ojo: con UDP el envio no confirma la entrega.');
            exit(0);

        default:
            cwrite('Uso: centinela-admin syslog [--show|--server host[:puerto] [tcp|udp]|--min-sev SEV|--test|--disable]');
            exit(1);
    }

case 'show':
    cwrite('Fichero        : ' . $cfgFile);
    cwrite('Usuario        : ' . ($cfg['auth']['user'] ?: '(sin definir)'));
    cwrite('Contrasena     : ' . ($cfg['auth']['hash'] ? 'configurada' : 'SIN CONFIGURAR'));
    cwrite('Segundo factor : ' . ($cfg['auth']['totp_secret'] ? 'configurado' : 'SIN CONFIGURAR')
        . ($cfg['auth']['totp_required'] ? ' (obligatorio)' : ' (opcional)'));
    cwrite('Allowlist IP   : ' . ($cfg['ip_allowlist'] ? implode(', ', $cfg['ip_allowlist']) : 'vacia (sin filtro en la aplicacion)'));
    cwrite('Avisos a       : ' . (mail_recipients($cfg) ? implode(', ', mail_recipients($cfg)) : 'SIN CONFIGURAR'));
    cwrite('Informe semanal: ' . (!empty($cfg['mail']['weekly']) ? 'activado (dia ' . $cfg['mail']['weekly_day'] . ', ' . $cfg['mail']['weekly_hour'] . ':00)' : 'desactivado'));
    cwrite('Looking glass  : ' . (!empty($cfg['lg']['enabled']) ? (!empty($cfg['lg']['public']) ? 'publico' : 'privado') : 'desactivado'));
    cwrite('Directorio     : ' . $cfg['state_dir']);
    exit(0);

case 'check':
    $ok = true;
    $line = function (bool $good, string $msg) use (&$ok) {
        cwrite(($good ? '  [ok]   ' : '  [FALLO] ') . $msg);
        if (!$good) { $ok = false; }
    };
    cwrite('Diagnostico de Centinela');
    cwrite(str_repeat('-', 55));
    cwrite('  Plataforma: ' . platform_label() . (empty($cfg['platform']) ? ' (detectada; fija \'platform\' en config.php)' : ''));
    $line(is_readable($cfgFile), "Configuracion legible: {$cfgFile}");
    $line((bool) $cfg['auth']['hash'], 'Contrasena configurada');
    $line(!$cfg['auth']['totp_required'] || (bool) $cfg['auth']['totp_secret'], 'Segundo factor configurado');
    $line((bool) mail_recipients($cfg), 'Destinatario de avisos configurado');
    $line(is_dir($cfg['state_dir']), 'Directorio de estado existe: ' . $cfg['state_dir']);
    $stateFile = $cfg['state_dir'] . '/state.json';
    $line(is_readable($stateFile), 'Estado generado por el colector');
    if (is_readable($stateFile)) {
        $age = time() - (int) @filemtime($stateFile);
        $line($age < 1800, 'Estado reciente (' . $age . ' s)');
    }
    $line(sendmail_bin_exists(), 'sendmail disponible para el envio de correo');
    foreach (['centinela-collect.timer', 'centinela-weekly.timer'] as $t) {
        $st = run(['/usr/bin/systemctl', 'is-enabled', $t], 5);
        $line($st['ok'], "Temporizador {$t} activo");
    }
    cwrite(str_repeat('-', 55));
    cwrite($ok ? 'Todo correcto.' : 'Hay comprobaciones fallidas.');
    exit($ok ? 0 : 1);

case 'test-mail':
    $rep = dirname(__FILE__) . '/centinela-report';
    $args = [PHP_BINARY, $rep, '--test'];
    if (isset($argv[2])) { $args[] = '--to'; $args[] = $argv[2]; }
    $r = run($args, 60);
    fwrite(STDOUT, $r['out'] . "\n");
    fwrite(STDERR, $r['err'] . "\n");
    exit($r['code']);

default:
    cwrite(<<<TXT
Centinela - utilidad de administracion

  centinela-admin passwd [usuario]     Fija la contrasena del panel
  centinela-admin totp [--new]         Genera o muestra el segundo factor
  centinela-admin email <direccion>    Administrador que recibe los avisos
  centinela-admin show                 Muestra la configuracion vigente
  centinela-admin check                Diagnostico de la instalacion
  centinela-admin test-mail [dir]      Envia un correo de prueba
  centinela-admin user ...             Cuentas adicionales del panel
  centinela-admin guard ...            Geo-valla de los servicios de administracion
  centinela-admin syslog ...           Exportacion del estado a un syslog remoto
  centinela-admin update ...           Actualizacion automatica desde GitHub

TXT);
    exit($cmd === 'help' ? 0 : 1);
}

function sendmail_bin_exists(): bool
{
    foreach (['/usr/sbin/sendmail', '/usr/lib/sendmail', '/usr/bin/sendmail'] as $p) {
        if (is_executable($p)) { return true; }
    }
    return false;
}
